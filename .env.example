# Copie para .env e preencha. Nunca versione o arquivo .env.
# Todas as variáveis VITE_* vão para o navegador: use apenas valores públicos.

# Projeto Supabase (Configurações > API)
VITE_SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
# Chave publicável (anon). NUNCA use a service_role aqui.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Operon Fomento: nome de usuário do bot do Telegram, sem @ (ex.: MeuBot)
VITE_OPERON_TELEGRAM_BOT=

# Segredos de servidor (OPENROUTER_API_KEY, RESEND_API_KEY, SUPABASE_SERVICE_ROLE_KEY etc.)
# ficam SOMENTE nos segredos das Edge Functions do Supabase, nunca neste arquivo.
